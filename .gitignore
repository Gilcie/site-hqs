# Segredos e configuração local
.env

# Biblioteca de HQs e cache gerado (conteúdo, não código)
# As pastas em si ficam versionadas (com .gitkeep), só o conteúdo é ignorado
/comics/*
!/comics/.gitkeep
/cache/*
!/cache/.gitkeep
*.cbr
*.cbz

# Python
__pycache__/
*.pyc
.venv/

# Configuração local de editor/IDE
.claude/

# Outros
.DS_Store
Thumbs.db
